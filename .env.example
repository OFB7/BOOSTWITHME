# BOOSTWITHME production environment
NODE_ENV=production
PORT=10000
APP_URL=https://boostwithme.com
FRONTEND_URL=https://boostwithme.com

# PostgreSQL (Render can inject this from the linked database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DB_POOL_MAX=10

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Paystack — NEVER commit or paste the live secret into source control/chat
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CURRENCY=NGN

# Business identity
ADMIN_EMAIL=danyellsdave7@gmail.com
ADMIN_NAME=David Daniel
ADMIN_PHONE=08144594011
SUPPORT_EMAIL=boostwithme7@gmail.com
DOMAIN=boostwithme.com
EMAIL_FROM=boostwithme7@gmail.com

# Optional email delivery bridge
EMAIL_WEBHOOK_URL=
